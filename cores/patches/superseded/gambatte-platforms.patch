Add the three NextUI toolchain targets missing upstream. h700 uses the tg5040
branch (Cortex-A53); my355 uses tg5050 and lets its Cortex-A55 toolchain select
the CPU.

--- a/Makefile.libretro
+++ b/Makefile.libretro
@@ -386,5 +386,43 @@ else ifeq ($(platform), gcw0)
    CFLAGS += -fomit-frame-pointer -ffast-math -march=mips32 -mtune=mips32r2 -mhard-float
    CXXFLAGS += $(CFLAGS)
 
+# NextUI aarch64, Cortex-A53 (tg5040 and h700)
+else ifeq ($(platform), tg5040)
+   TARGET := $(TARGET_NAME)_libretro.so
+   CC = $(CROSS_COMPILE)gcc
+   CXX = $(CROSS_COMPILE)g++
+   AR = $(CROSS_COMPILE)ar
+   SHARED := -shared -Wl,--version-script=$(version_script)
+   LDFLAGS += -fPIC -flto
+   PLATFORM_DEFINES := -DCC_RESAMPLER -DCC_RESAMPLER_NO_HIGHPASS
+   CFLAGS += -mcpu=cortex-a53 -fomit-frame-pointer -ffast-math -fPIC -flto
+   CXXFLAGS += $(CFLAGS)
+
+# NextUI aarch64, Cortex-A55 (tg5050 and my355)
+else ifeq ($(platform), tg5050)
+   TARGET := $(TARGET_NAME)_libretro.so
+   CC = $(CROSS_COMPILE)gcc
+   CXX = $(CROSS_COMPILE)g++
+   AR = $(CROSS_COMPILE)ar
+   SHARED := -shared -Wl,--version-script=$(version_script)
+   LDFLAGS += -fPIC -flto
+   PLATFORM_DEFINES := -DCC_RESAMPLER -DCC_RESAMPLER_NO_HIGHPASS
+   CFLAGS += -fomit-frame-pointer -ffast-math -fPIC -flto
+   CXXFLAGS += $(CFLAGS)
+
+# NextUI armv7 hard-float (my282)
+else ifeq ($(platform), my282)
+   TARGET := $(TARGET_NAME)_libretro.so
+   CC = $(CROSS_COMPILE)gcc
+   CXX = $(CROSS_COMPILE)g++
+   AR = $(CROSS_COMPILE)ar
+   SHARED := -shared -Wl,--version-script=$(version_script)
+   LDFLAGS += -fPIC -flto
+   PLATFORM_DEFINES := -DCC_RESAMPLER -DCC_RESAMPLER_NO_HIGHPASS
+   CFLAGS += -marm -mcpu=cortex-a7 -mtune=cortex-a7 -march=armv7-a
+   CFLAGS += -mfpu=neon-vfpv4 -mfloat-abi=hard
+   CFLAGS += -fomit-frame-pointer -ffast-math -fPIC -flto
+   CXXFLAGS += $(CFLAGS)
+
 # RETROFW
 else ifeq ($(platform), retrofw)
