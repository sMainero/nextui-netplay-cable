#!/bin/sh
#
# Not a binary. This shadows the real minarch.elf on PATH.
#
# Emulator paks invoke `minarch.elf <core.so> <rom>` unqualified, so it is
# resolved through PATH (set in MinUI.pak/launch.sh). A launch stub prepends
# this directory, which lets us rewrite that invocation to route the core
# through the netplay shim - without modifying minarch or any system file.
#
# With no session armed we exec the real minarch with the arguments we were
# given, byte for byte, so a normal game launch is completely unaffected.

CORE="$1"
[ $# -gt 0 ] && shift

: "${SDCARD_PATH:=/mnt/SDCARD}"
: "${PLATFORM:=tg5040}"
: "${SYSTEM_PATH:=$SDCARD_PATH/.system/$PLATFORM}"

NP="$SDCARD_PATH/Tools/$PLATFORM/Netplay.pak"
SHIM="$NP/bin/$PLATFORM/netplay_shim.so"

# Two ways we can be reached, and they need different answers for "where is the
# real minarch":
#   - on PATH, shadowing it for one pak (launch-stub.sh)  -> system path is real
#   - bind-mounted over it, for every pak (bind-mount.sh) -> system path is US,
#     and exec'ing it would recurse forever; the real binary is at the stash
if [ -f /tmp/netplay/minarch.real ]; then
	REAL_MINARCH=/tmp/netplay/minarch.real
else
	REAL_MINARCH="$SYSTEM_PATH/bin/minarch.elf"
fi

# Anything unexpected -> behave exactly like stock.
if [ ! -x "$REAL_MINARCH" ] || [ -z "$CORE" ]; then
	exec "$REAL_MINARCH" "$CORE" "$@"
fi

# A session is described by a file the pak app writes. Games launched from the
# game list are started by NextUI, so there is nowhere in that path for anyone
# to set an environment variable - we have to find the file ourselves and export
# it for the shim. Same reason the force flag is a file.
if [ -z "$NETPLAY_SESSION" ] && [ -f "$NP/state/session" ]; then
	NETPLAY_SESSION="$NP/state/session"
	export NETPLAY_SESSION
fi

# The force flag routes through the shim with no session, which is how
# passthrough gets verified on device.
if [ -z "$NETPLAY_SESSION" ] &&
   [ "$NETPLAY_FORCE_SHIM" != "1" ] &&
   [ ! -f "$NP/state/force-shim" ]; then
	exec "$REAL_MINARCH" "$CORE" "$@"
fi

if [ ! -f "$SHIM" ]; then
	echo "[netplay] shim missing at $SHIM, launching stock" >&2
	exec "$REAL_MINARCH" "$CORE" "$@"
fi

# The shim has to be loaded under the real core's filename. minarch derives
# core.name from basename(path) truncated at the last underscore, and core.name
# feeds config_dir and states_dir - load it as anything else and the user's save
# states move. Copying per core name is what keeps those paths identical.
CORE_NAME="$(basename "$CORE")"

# A pak-supplied core replaces the system one for this launch, without touching
# anything in .system. Needed where the stock build lacks a feature: NextUI
# builds gambatte without HAVE_NETWORK, so its Game Link support is compiled
# out entirely and no amount of configuration will bring it back.
REAL_CORE="$CORE"
if [ -f "$NP/cores/override/$PLATFORM/$CORE_NAME" ]; then
	REAL_CORE="$NP/cores/override/$PLATFORM/$CORE_NAME"
	echo "[netplay] using pak core override for $CORE_NAME" >&2
fi

SHIM_DIR="$NP/cores"
SHIM_AS="$SHIM_DIR/$CORE_NAME"

mkdir -p "$SHIM_DIR"
if ! cp -f "$SHIM" "$SHIM_AS"; then
	echo "[netplay] could not stage shim as $SHIM_AS, launching stock" >&2
	exec "$REAL_MINARCH" "$CORE" "$@"
fi

NETPLAY_REAL_CORE="$REAL_CORE"
export NETPLAY_REAL_CORE

exec "$REAL_MINARCH" "$SHIM_AS" "$@"
