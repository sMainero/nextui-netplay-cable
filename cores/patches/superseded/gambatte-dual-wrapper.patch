+#ifdef NETPLAY_DUAL_INSTANCE
+struct DualRunContext {
+   union {
+      gambatte::uint_least32_t u32[SOUND_BUFF_SIZE];
+      int16_t i16[2 * SOUND_BUFF_SIZE];
+   } sound;
